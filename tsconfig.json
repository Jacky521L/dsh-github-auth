{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true,
    "lib": ["ES2024", "DOM"], "types": ["node", "react"]
  },
  "include": ["shared/**/*.ts", "shared/**/*.tsx", "packages/*/src/**/*.ts", "packages/*/src/**/*.tsx"]
}
