{
  "name": "dsh-github-auth-workspace",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run pack",
    "release:private": "node scripts/release-private.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "esbuild": "0.25.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
